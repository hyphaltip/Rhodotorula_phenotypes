# DuckDB database file -- fully rebuildable from data/ via scripts/db/
# (see DATABASE_DESIGN.md §9). Don't commit it; it's large and disposable.
db/*.duckdb
db/*.duckdb.wal

# pixi-managed environment -- rebuilt from pixi.toml/pixi.lock via `pixi install`
.pixi/

__pycache__/
*.pyc

# Working/sandbox dirs not tracked for now
ignore/

# Preprocessed colony-measurement Parquet files -- large; comment out to track
data/preprocessed/

# Derived analysis outputs -- rebuildable from source via each analysis' run.sh
analysis/*/results/
analysis/*/*.html
analysis/*/*.pdf
analysis/*/*.knit.md
analysis/*/*_files/

# Exception: keep the plate-position report's figures -- the rendered GitHub
# markdown (explore_plate_position.md) links to them relative to the report dir,
# so they must be tracked or the figures break on GitHub. Tables stay ignored.
!analysis/explore_plate_position/results/
!analysis/explore_plate_position/results/figures/
analysis/explore_plate_position/results/tables/

# Exception: same for the growth-rates report figures (growth_rates.md links
# results/figures/*.png relative to the report dir). Tables stay ignored.
!analysis/growth_rates/results/
!analysis/growth_rates/results/figures/
analysis/growth_rates/results/tables/

# Exception: control-late-timepoint phenotype tables (per-window CSVs) are
# committed by request -- they are small and directly consumed downstream.
!analysis/control_late_timepoint_phenotype/results/

# Ideation session 2026-08-15: large derived intermediate extract is rebuildable
# via scripts/build_series.py; only final tables/figures/docs are tracked.
analysis/ideas/2026-08-15-color-phenotype-space/data/
!analysis/ideas/2026-08-15-color-phenotype-space/data/strain_metadata.tsv
!analysis/ideas/2026-08-15-color-phenotype-space/results/
!analysis/ideas/2026-08-15-color-phenotype-space/figures/

# GWAS downstream outputs (2026-08-17): keep the small summary tables/figures,
# ignore the large rebuildable intermediates (~21 GB total):
#   tierB/ld_cache: per-window LD .npz/.vcor2 (~16 GB) -- rebuildable by NGWA
#   pixy/cohort.*.vcf.gz: filtered genotype VCFs (~4 GB), tbi indexes
#   loco/binaries + raw per-chr assoc output (~447 MB) -- keep only loco_merged_*
#   scratch/log/probe files at the idea dir root
analysis/ideas/2026-08-15-color-phenotype-space/results/gwas/tierB/ld_cache/
analysis/ideas/2026-08-15-color-phenotype-space/results/gwas/pixy/*.vcf.gz
analysis/ideas/2026-08-15-color-phenotype-space/results/gwas/pixy/*.vcf.gz.tbi
analysis/ideas/2026-08-15-color-phenotype-space/results/gwas/loco/*
!analysis/ideas/2026-08-15-color-phenotype-space/results/gwas/loco/loco_merged_*.csv
!analysis/ideas/2026-08-15-color-phenotype-space/results/gwas/loco/loco_submit.sbatch
analysis/ideas/2026-08-15-color-phenotype-space/*.log
analysis/ideas/2026-08-15-color-phenotype-space/slurm*.out
analysis/ideas/2026-08-15-color-phenotype-space/slurm*.err
analysis/ideas/2026-08-15-color-phenotype-space/*probe*
t.txt.gz
27499755_envprobe.log
27499756_envprobe.log
retry2_*.log
